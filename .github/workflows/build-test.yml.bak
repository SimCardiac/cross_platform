name: Build and Test

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-24.04
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v4
    
    - name: Install system dependencies
      run: |
        sudo apt-get update
        sudo apt-get install -y build-essential gfortran cmake git curl \
          python3 python3-pip ca-certificates gnupg2
    
    - name: Download and extract Spack
      run: |
        cd $HOME
        wget https://github.com/spack/spack/releases/download/v1.0.2/spack-1.0.2.tar.gz
        tar -xzf spack-1.0.2.tar.gz
        rm spack-1.0.2.tar.gz
        mv spack-1.0.2 spack

    - name: Create Spack environment
      run: |
        . $HOME/spack/share/spack/setup-env.sh
        spack compiler find
        spack env create cross
        spack env activate cross
        
        # Create spack.yaml in the environment
        cat > $HOME/spack/var/spack/environments/cross/spack.yaml << 'EOF'

        EOF
    
    - name: Install packages with Spack
      run: |
        . $HOME/spack/share/spack/setup-env.sh
        spack env activate cross
        spack concretize -f
        spack install --verbose
      timeout-minutes: 120
    
    - name: Load Spack environment and build project
      run: |
        . $HOME/spack/share/spack/setup-env.sh
        spack env activate cross
        spack load gcc@14.2.0
        spack load openmpi@5.0.8
        spack load kokkos@4.6.01
        spack load petsc@3.23.4
        
        # Build the project
        mkdir -p build
        cd build
        cmake .. \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_C_COMPILER=$(which gcc) \
          -DCMAKE_CXX_COMPILER=$(which g++)
        make VERBOSE=1
    
    - name: Run test executable
      run: |
        . $HOME/spack/share/spack/setup-env.sh
        spack env activate cross
        spack load gcc@14.2.0
        spack load openmpi@5.0.8
        spack load kokkos@4.6.01
        spack load petsc@3.23.4
        
        cd build
        ./test_kokkos_petsc
    
    - name: Upload build artifacts
      if: always()
      uses: actions/upload-artifact@v4
      with:
        name: build-artifacts
        path: |
          build/
          !build/**/*.o
